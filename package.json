    "hono": "^4.7.0",
    "hyparquet": "^1.30.1",
    "hyparquet-compressors": "^1.1.1",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
